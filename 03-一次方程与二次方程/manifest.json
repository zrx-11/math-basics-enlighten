 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "方程 2(x−1)=x+3 的解是：",
   "options": [
    "x=1",
    "x=5",
    "x=3",
    "x=−5"
   ],
   "answer": 1,
   "explain": "展开 2x−2=x+3，移项得 x=5。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "关于 x 的方程 ax=b，下列说法正确的是：",
   "options": [
    "一定有唯一解 x=b/a",
    "a=0 时一定无解",
    "a=0 且 b=0 时任意 x 都是解",
    "a=0 且 b≠0 时有无穷多解"
   ],
   "answer": 2,
   "explain": "a≠0 时唯一解；a=0、b≠0 无解；a=0、b=0 时恒成立，任意解。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "方程组 x+y=7，x−y=1 的解是：",
   "options": [
    "x=4，y=3",
    "x=3，y=4",
    "x=5，y=2",
    "x=6，y=1"
   ],
   "answer": 0,
   "explain": "两式相加 2x=8 得 x=4，代回得 y=3。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "消元后出现 0=5 这样的式子，说明方程组：",
   "options": [
    "有唯一解",
    "有无穷多解",
    "无解",
    "解为正数"
   ],
   "answer": 2,
   "explain": "0=5 是矛盾式，说明不存在同时满足所有方程的解，即无解。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "方程 x²−5x+6=0 的两根是：",
   "options": [
    "2 和 3",
    "−2 和 −3",
    "1 和 6",
    "−1 和 −6"
   ],
   "answer": 0,
   "explain": "因式分解 (x−2)(x−3)=0，或用公式：Δ=1，x=(5±1)/2。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "方程 x²+2x+5=0 的根的情况是：",
   "options": [
    "两个不等实根",
    "两个相等实根",
    "没有实根",
    "无法判断"
   ],
   "answer": 2,
   "explain": "Δ=4−20=−16<0，无实根。"
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "方程 x⁴−5x²+4=0 的实根个数是：",
   "options": [
    "2",
    "3",
    "4",
    "0"
   ],
   "answer": 2,
   "explain": "设 t=x²：t²−5t+4=0 得 t=1 或 4，均非负，故 x=±1、±2，共 4 个实根。"
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "解分式方程时，验根的目的是：",
   "options": [
    "检查计算是否正确",
    "排除使分母为零的增根",
    "确认解是正数",
    "检查是否为整数"
   ],
   "answer": 1,
   "explain": "去分母时乘了含未知数的式子，可能引入使分母为零的根，必须代回原方程排除。"
  },
  {
   "id": "q09",
   "chapterId": "__all__",
   "type": "single",
   "question": "方程 x²−2x−8=0 的两根之和与两根之积分别是：",
   "options": [
    "2 和 −8",
    "−2 和 −8",
    "2 和 8",
    "−2 和 8"
   ],
   "answer": 0,
   "explain": "a=1，b=−2，c=−8：和为 −b/a=2，积为 c/a=−8。"
  },
  {
   "id": "q10",
   "chapterId": "__all__",
   "type": "single",
   "question": "若关于 x 的方程 kx²+2x+1=0 有两个不相等的实根，则 k 的取值范围是：",
   "options": [
    "k<1",
    "k<1 且 k≠0",
    "k>1",
    "k≤1"
   ],
   "answer": 1,
   "explain": "二次方程要求 k≠0；两个不等实根要求 Δ=4−4k>0，即 k<1。合起来 k<1 且 k≠0。"
  }
 ],
