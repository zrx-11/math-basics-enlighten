 "glossary": [
  {
   "term": "方程",
   "def": "含未知数的等式，使等式成立的未知数值叫解。",
   "chapterId": "ch01"
  },
  {
   "term": "移项",
   "def": "把项从等式一边移到另一边并变号，本质是两边同加相反数。",
   "chapterId": "ch01"
  },
  {
   "term": "消元",
   "def": "通过代入或加减，减少方程组中未知数的个数。",
   "chapterId": "ch02"
  },
  {
   "term": "配方",
   "def": "把二次式改写成完全平方加常数的形式。",
   "chapterId": "ch03"
  },
  {
   "term": "判别式",
   "def": "Δ=b²−4ac，判断二次方程实根个数。",
   "chapterId": "ch03"
  },
  {
   "term": "韦达定理",
   "def": "两根之和为 −b/a，两根之积为 c/a。",
   "chapterId": "ch03"
  },
  {
   "term": "换元",
   "def": "用一个新变量替换原式中的某部分，达到降次或简化。",
   "chapterId": "ch04"
  },
  {
   "term": "增根",
   "def": "变形后产生、但不满足原方程的解。",
   "chapterId": "ch04"
  },
  {
   "term": "验根",
   "def": "把候选解代回原方程，排除增根。",
   "chapterId": "ch04"
  }
 ],
