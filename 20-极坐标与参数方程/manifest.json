   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "参数方程 x=t²，y=t（t≥0）化为普通方程是：",
   "options": [
    "y²=x（x≥0）",
    "y²=x（x∈R）",
    "y=x²",
    "x=y²"
   ],
   "answer": 0,
   "explain": "t=√x≥0，y=√x，平方得 y²=x，且 x≥0。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
