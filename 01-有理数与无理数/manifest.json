 "glossary": [
  {
   "term": "有理数",
   "def": "能写成两个整数之比 m/n（n≠0）的数，包含整数与分数。",
   "chapterId": "ch01"
  },
  {
   "term": "无理数",
   "def": "不是有理数的实数，即不能写成两个整数之比的数。",
   "chapterId": "ch04"
  },
  {
   "term": "相反数",
   "def": "对 a 而言是 −a；两者在数轴上关于原点对称。",
   "chapterId": "ch01"
  },
  {
   "term": "绝对值",
   "def": "数轴上表示 a 的点到原点的距离，恒为非负数。",
   "chapterId": "ch01"
  },
  {
   "term": "数轴",
   "def": "规定了原点、正方向和单位长度的直线。",
   "chapterId": "ch01"
  },
  {
   "term": "乘方",
   "def": "n 个相同因数 a 相乘的简写，记作 a^n。",
   "chapterId": "ch03"
  },
  {
   "term": "开方",
   "def": "求满足 x^n=a 的 x 的运算，是乘方的逆运算。",
   "chapterId": "ch03"
  },
  {
   "term": "算术根",
   "def": "非负的那个 n 次方根，记作 ⁿ√a。",
   "chapterId": "ch03"
  },
  {
   "term": "稠密性",
   "def": "任意两个有理数之间还存在有理数，这个性质叫有理数的稠密性。",
   "chapterId": "ch04"
  },
  {
   "term": "代数数",
   "def": "某个整系数多项式方程的根。",
   "chapterId": "ch05"
  },
  {
   "term": "超越数",
   "def": "不是代数数的实数，如 π、e。",
   "chapterId": "ch05"
  },
  {
   "term": "截断序列",
   "def": "把无理数的小数在第 n 位后截断得到的有理数列。",
   "chapterId": "ch05"
  }
 ],
