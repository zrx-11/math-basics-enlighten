 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "下列各数中，是负有理数的是：",
   "options": [
    "−3/4",
    "0",
    "|−2|",
    "−(−5)"
   ],
   "answer": 0,
   "explain": "−3/4 是负分数，属有理数。0 不是负数；|−2|=2 是正数；−(−5)=5 是正数。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "比较 −7/8 与 −6/7 的大小，正确的是：",
   "options": [
    "−7/8 > −6/7",
    "−7/8 < −6/7",
    "−7/8 = −6/7",
    "无法比较"
   ],
   "answer": 1,
   "explain": "通分得 −49/56 与 −48/56。两负数比较，绝对值大的反而小，49>48，所以 −7/8 < −6/7。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "计算 (−2)(−3)+(−4) 的结果是：",
   "options": [
    "−10",
    "2",
    "10",
    "−2"
   ],
   "answer": 1,
   "explain": "(−2)(−3)=6（同号得正），再加 −4 得 2。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "下列运算中，能说明有理数集对除法不封闭的是：",
   "options": [
    "3÷4=3/4",
    "(−6)÷2=−3",
    "5÷0 没有意义",
    "0÷7=0"
   ],
   "answer": 2,
   "explain": "封闭要求“任意两个元素运算后仍在集合内”。5÷0 因为除数没有倒数而不成立，说明除法必须把 0 排除在外。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "下列各式中值等于 −16 的是：",
   "options": [
    "(−2)^4",
    "−2^4",
    "(−4)^2",
    "2^4"
   ],
   "answer": 1,
   "explain": "−2^4 表示 2 的四次幂取相反数，等于 −16；(−2)^4=16，(−4)^2=16，2^4=16。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "下列方根中，结果不是有理数的是：",
   "options": [
    "√49",
    "∛(−27)",
    "√2",
    "√0.25"
   ],
   "answer": 2,
   "explain": "√49=7；∛(−27)=−3；√0.25=0.5；而 2 不是任何有理数的平方，√2 不是有理数。"
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "“√2 不是有理数”的反证中，关键矛盾是：",
   "options": [
    "m、n 都很大",
    "m、n 同為偶数，与互质矛盾",
    "√2 是无限小数",
    "2 不是平方数"
   ],
   "answer": 1,
   "explain": "由 m²=2n² 推出 m 偶，再由 m=2k 推出 n 偶，于是 m、n 有公因数 2，与“最简分数”矛盾。"
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "下列数中是无理数的是：",
   "options": [
    "0.121212…（循环）",
    "√16",
    "π",
    "22/7"
   ],
   "answer": 2,
   "explain": "循环小数是有理数；√16=4；22/7 是分数；π 不是任何整系数多项式方程的根，是无理数（超越数）。"
  },
  {
   "id": "q09",
   "chapterId": "ch05",
   "type": "single",
   "question": "用 √2 的截断序列 x_n 近似，要保证误差小于 10^-5，至少取到第几位？",
   "options": [
    "3",
    "4",
    "5",
    "6"
   ],
   "answer": 2,
   "explain": "误差上界是 10^-n，要求 10^-n<10^-5，需 n≥5，故取 x_5=1.41421。"
  },
  {
   "id": "q10",
   "chapterId": "ch05",
   "type": "single",
   "question": "下列数中，属于超越数的是：",
   "options": [
    "√2",
    "黄金比 (1+√5)/2",
    "π",
    "22/7"
   ],
   "answer": 2,
   "explain": "√2 是 x²−2=0 的根；黄金比是 x²−x−1=0 的根；22/7 是有理数；π 不是任何整系数多项式方程的根，是超越数。"
  },
  {
   "id": "q11",
   "chapterId": "__all__",
   "type": "single",
   "question": "关于有理数与无理数，下列说法正确的是：",
   "options": [
    "无限小数都是无理数",
    "√9 是无理数",
    "有理数在数轴上稠密但不连续",
    "两个无理数的和一定是无理数"
   ],
   "answer": 2,
   "explain": "无限循环小数是有理数；√9=3；√2+(−√2)=0 是有理数，故 D 错；有理数稠密但数轴上有缝，C 正确。"
  },
  {
   "id": "q12",
   "chapterId": "__all__",
   "type": "single",
   "question": "用截断序列逼近 π，取 x_2=3.14，误差满足：",
   "options": [
    "误差小于 0.001",
    "误差小于 0.01",
    "误差大于 0.01",
    "无法判断"
   ],
   "answer": 1,
   "explain": "截断到两位小数，砍掉的尾部小于 0.01，故 0≤π−3.14<0.01。"
  },
  {
   "id": "q13",
   "chapterId": "__all__",
   "type": "single",
   "question": "“代数数可数、实数不可数”这个论证直接说明：",
   "options": [
    "所有实数都是代数数",
    "超越数存在且数量极多",
    "代数数都是有理数",
    "π 是有理数"
   ],
   "answer": 1,
   "explain": "可数集合无法覆盖不可数集合，所以必有非代数数的实数，即超越数；而且余下的数量远多于代数数。"
  }
 ],
