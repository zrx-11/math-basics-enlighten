 "glossary": [
  {
   "term": "有理分式",
   "def": "两个整式的商 A/B，B 含字母且不为零。",
   "chapterId": "ch01"
  },
  {
   "term": "约分",
   "def": "约去分子分母的公因式。",
   "chapterId": "ch01"
  },
  {
   "term": "最简公分母",
   "def": "各分母所有因式最高次幂的乘积。",
   "chapterId": "ch01"
  },
  {
   "term": "增根",
   "def": "变形后产生但不满足原方程的解。",
   "chapterId": "ch02"
  },
  {
   "term": "真分式",
   "def": "分子次数低于分母次数的分式。",
   "chapterId": "ch03"
  },
  {
   "term": "部分分式",
   "def": "把真分式拆成的若干简单分式。",
   "chapterId": "ch03"
  },
  {
   "term": "算术根",
   "def": "非负的 n 次方根。",
   "chapterId": "ch04"
  },
  {
   "term": "分母有理化",
   "def": "通过乘共轭式消去分母中的根号。",
   "chapterId": "ch04"
  },
  {
   "term": "共轭式",
   "def": "√a+√b 与 √a−√b 互为共轭，乘积为 a−b。",
   "chapterId": "ch04"
  }
 ],
