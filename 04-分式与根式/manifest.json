 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "分式 1/(x²−9) 有意义的条件是：",
   "options": [
    "x≠3",
    "x≠−3",
    "x≠±3",
    "x≠0"
   ],
   "answer": 2,
   "explain": "分母 x²−9=(x−3)(x+3)，要求 x≠3 且 x≠−3。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "化简 (x²−1)/(x²+x) 的结果是：",
   "options": [
    "(x−1)/x",
    "x−1",
    "1/x",
    "(x+1)/x"
   ],
   "answer": 0,
   "explain": "分子 (x−1)(x+1)，分母 x(x+1)，约去 (x+1) 得 (x−1)/x（x≠0，x≠−1）。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "解分式方程产生增根的根本原因是：",
   "options": [
    "计算失误",
    "去分母时乘了含未知数的式子",
    "方程次数变高",
    "没有通分"
   ],
   "answer": 1,
   "explain": "乘以含未知数的式子会把原定义域外的点带入等式，使不满足原方程的值成为候选解。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "方程 1/(x−2)=0 的解的情况是：",
   "options": [
    "x=2",
    "无解",
    "x=0",
    "任意实数"
   ],
   "answer": 1,
   "explain": "分式的值为零要求分子为零且分母不为零；这里分子恒为 1，故无解。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "分式 (x²+1)/(x−1) 属于：",
   "options": [
    "真分式",
    "假分式",
    "整式",
    "无法判断"
   ],
   "answer": 1,
   "explain": "分子次数 2 不低于分母次数 1，是假分式，需先做除法。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "分解 1/[(x−1)(x−2)] 时，应设为：",
   "options": [
    "A/(x−1)+B/(x−2)",
    "A/(x−1)+B/(x−2)+C",
    "(Ax+B)/(x−1)(x−2)",
    "A/[(x−1)(x−2)]"
   ],
   "answer": 0,
   "explain": "分母是两个不同的一次因式，各对应一个常数分子的一次分式。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "化简 √(x²−4x+4) 的结果是：",
   "options": [
    "x−2",
    "|x−2|",
    "2−x",
    "x+2"
   ],
   "answer": 1,
   "explain": "被开方数是 (x−2)²，开方得绝对值 |x−2|，符号随 x 变化。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "把 1/(√5−2) 分母有理化的结果是：",
   "options": [
    "√5+2",
    "(√5+2)/9",
    "√5−2",
    "(√5−2)/9"
   ],
   "answer": 0,
   "explain": "分子分母同乘 (√5+2)：分母 (√5)²−2²=5−4=1，所以结果为 √5+2。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q09",
   "chapterId": "__all__",
   "type": "single",
   "question": "方程 (x²−1)/(x−1)=2 的解是：",
   "options": [
    "x=1",
    "x=−1",
    "无解",
    "x=±1"
   ],
   "answer": 2,
   "explain": "约分后 x+1=2 得 x=1，但 x=1 使原分母为零，是增根；原方程无解。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q10",
   "chapterId": "__all__",
   "type": "single",
   "question": "化简 √12+√27−√3 的结果是：",
   "options": [
    "4√3",
    "6√3",
    "2√3",
    "√3"
   ],
   "answer": 0,
   "explain": "√12=2√3，√27=3√3，合并得 2√3+3√3−√3=4√3。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  }
