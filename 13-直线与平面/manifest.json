 "glossary": [
  {
   "term": "异面直线",
   "def": "不同在任何一个平面内的两条直线。",
   "chapterId": "ch01"
  },
  {
   "term": "线面平行",
   "def": "直线与平面没有公共点。",
   "chapterId": "ch01"
  },
  {
   "term": "线面垂直",
   "def": "直线垂直于平面内所有直线。",
   "chapterId": "ch02"
  },
  {
   "term": "射影",
   "def": "斜线在平面内的正投影。",
   "chapterId": "ch02"
  },
  {
   "term": "三垂线定理",
   "def": "平面内直线垂直于射影则垂直于斜线。",
   "chapterId": "ch02"
  },
  {
   "term": "二面角",
   "def": "两个半平面所成的图形。",
   "chapterId": "ch03"
  },
  {
   "term": "平面角",
   "def": "二面角中在棱上取点、两面内垂直棱的两射线夹角。",
   "chapterId": "ch03"
  },
  {
   "term": "线面角",
   "def": "斜线与射影所成的角。",
   "chapterId": "ch03"
  }
 ],
