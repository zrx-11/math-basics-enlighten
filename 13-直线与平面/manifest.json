 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "空间中两条直线的位置关系共有几种：",
   "options": [
    "2 种",
    "3 种",
    "4 种",
    "1 种"
   ],
   "answer": 1,
   "explain": "相交、平行、异面三种。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "线面平行的判定定理中，平面外直线需要与平面内的哪条直线平行：",
   "options": [
    "任意一条",
    "一条",
    "两条相交直线",
    "两条平行直线"
   ],
   "answer": 1,
   "explain": "只需与平面内的一条直线平行即可判定线面平行。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "判定一条直线垂直于一个平面，需要它垂直于平面内：",
   "options": [
    "一条直线",
    "两条平行直线",
    "两条相交直线",
    "三条直线"
   ],
   "answer": 2,
   "explain": "两条相交直线确定平面的方向，缺“相交”条件不成立。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "三垂线定理的作用是：",
   "options": [
    "把面面垂直化为线面垂直",
    "把空间垂直化为平面内的垂直",
    "求体积",
    "判断平行"
   ],
   "answer": 1,
   "explain": "它通过射影把空间中的垂直关系转化为平面内的垂直关系。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "二面角的平面角的两条边必须：",
   "options": [
    "都垂直于棱",
    "互相平行",
    "都在同一平面内",
    "都过棱的中点"
   ],
   "answer": 0,
   "explain": "在棱上取一点，分别在两个面内作垂直于棱的射线，这两条射线所成的角才是平面角。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "直线与平面所成角的范围是：",
   "options": [
    "(0°,90°)",
    "[0°,90°]",
    "[0°,180°]",
    "(0°,180°)"
   ],
   "answer": 1,
   "explain": "平行时为 0°，垂直时为 90°，故范围是 [0°,90°]。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "空间中两条直线都平行于第三条直线，则这两条直线：",
   "options": [
    "一定相交",
    "一定平行",
    "一定异面",
    "可能异面"
   ],
   "answer": 1,
   "explain": "平行的传递性在空间中仍成立，故两直线平行。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "直线 l 垂直于平面 α 内两条相交直线，则：",
   "options": [
    "l 平行于 α",
    "l 垂直于 α",
    "l 在 α 内",
    "无法判断"
   ],
   "answer": 1,
   "explain": "这正是线面垂直的判定定理。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  }
