  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "两条平行线被第三条直线所截，同旁内角的关系是：",
   "options": [
    "相等",
    "互补",
    "互余",
    "无法确定"
   ],
   "answer": 1,
   "explain": "两直线平行时同旁内角之和为 180°，即互补。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "一个三角形的两个内角分别为 50° 和 60°，第三个内角是：",
   "options": [
    "60°",
    "70°",
    "80°",
    "90°"
   ],
   "answer": 1,
   "explain": "180°−50°−60°=70°。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "下列条件能判定两个三角形全等的是：",
   "options": [
    "两边及其中一边的对角对应相等",
    "三个角对应相等",
    "两边及其夹角对应相等",
    "周长相等"
   ],
   "answer": 2,
   "explain": "SAS 是标准判定；SSA 与 AAA 都不足以判定全等。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "三角形两边长为 3 和 7，第三边 x 的取值范围是：",
   "options": [
    "3<x<7",
    "4<x<10",
    "0<x<10",
    "x>4"
   ],
   "answer": 1,
   "explain": "两边之差 4 < x < 两边之和 10。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "两个相似三角形的相似比为 1:2，则面积比为：",
   "options": [
    "1:2",
    "1:4",
    "2:1",
    "1:√2"
   ],
   "answer": 1,
   "explain": "面积比是相似比的平方，即 1:4。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "下列变换中，属于相似变换而非全等变换的是：",
   "options": [
    "平移",
    "旋转",
    "轴对称",
    "位似"
   ],
   "answer": 3,
   "explain": "位似会按比例改变大小，只保持形状；其余三种保形状也保大小。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "两个相似三角形的面积比为 9:16，则相似比为：",
   "options": [
    "9:16",
    "3:4",
    "4:3",
    "81:256"
   ],
   "answer": 1,
   "explain": "相似比是面积比的平方根，√(9/16)=3/4。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "下列条件中不能判定两个三角形全等的是：",
   "options": [
    "三边对应相等",
    "两角及夹边对应相等",
    "两边及其中一边的对角对应相等",
    "两边及其夹角对应相等"
   ],
   "answer": 2,
   "explain": "SSA 存在两种可能图形，不能判定全等。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  }
