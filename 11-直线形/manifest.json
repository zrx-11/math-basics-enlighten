 "glossary": [
  {
   "term": "余角",
   "def": "两角之和为 90°。",
   "chapterId": "ch01"
  },
  {
   "term": "补角",
   "def": "两角之和为 180°。",
   "chapterId": "ch01"
  },
  {
   "term": "对顶角",
   "def": "两直线相交形成的顶点相对的两个角。",
   "chapterId": "ch01"
  },
  {
   "term": "同位角",
   "def": "两条直线被第三条直线所截，位置相同的一对角。",
   "chapterId": "ch01"
  },
  {
   "term": "全等",
   "def": "能完全重合的两个图形。",
   "chapterId": "ch02"
  },
  {
   "term": "SSA",
   "def": "两边及其中一边的对角，不能判定全等。",
   "chapterId": "ch02"
  },
  {
   "term": "相似",
   "def": "对应角相等、对应边成比例的两个图形。",
   "chapterId": "ch03"
  },
  {
