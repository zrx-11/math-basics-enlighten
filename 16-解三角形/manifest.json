  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "已知 a=2、b=3、A=30°，则 B：",
   "options": [
    "只有一解",
    "可能有两解",
    "一定无解",
    "一定为直角"
   ],
   "answer": 1,
   "explain": "sinB=b sinA/a=3×0.5/2=0.75<1，B 有锐角与钝角两个候选，需检验，可能两解。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "已知 b=3、c=4、A=90°，则 a 等于：",
   "options": [
    "5",
    "7",
    "25",
    "√7"
   ],
   "answer": 0,
   "explain": "cosA=0，a²=9+16=25，a=5。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "三角形三边为 2、3、4，最大角是：",
   "options": [
    "锐角",
    "直角",
    "钝角",
    "无法判断"
   ],
   "answer": 2,
   "explain": "4²=16>2²+3²=13，故最大角为钝角。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "两边为 4 和 6、夹角 30°，面积是：",
   "options": [
    "12",
    "6",
    "24",
    "3"
   ],
   "answer": 1,
   "explain": "S=(1/2)×4×6×0.5=6。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "三边为 6、8、10 的三角形面积是：",
   "options": [
    "24",
    "48",
    "30",
    "20"
   ],
   "answer": 0,
   "explain": "p=12，S=√(12×6×4×2)=√576=24。"
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "在 △ABC 中，a=8、b=6、A=60°，则 sinB 等于：",
   "options": [
    "3√3/8",
    "3/4",
    "√3/2",
    "1/2"
   ],
   "answer": 0,
   "explain": "由 a/sinA=b/sinB 得 sinB=b sinA/a=6×(√3/2)/8=3√3/8。"
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "三边为 5、12、13 的三角形，其最大角是：",
   "options": [
    "锐角",
    "直角",
    "钝角",
    "60°"
   ],
   "answer": 1,
   "explain": "13²=169=5²+12²，故为直角三角形，最大角 90°。"
  }
 ],
