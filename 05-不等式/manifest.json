 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "若 a>b，则下列一定成立的是：",
   "options": [
    "a²>b²",
    "−2a>−2b",
    "a−3>b−3",
    "1/a>1/b"
   ],
   "answer": 2,
   "explain": "两边同减 3 不变号，C 恒成立。A 在 a=1、b=−2 时不成立；B 应变为 −2a<−2b；D 要求同号。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "解不等式 −3x≥6，解集是：",
   "options": [
    "x≥−2",
    "x≤−2",
    "x≥2",
    "x≤2"
   ],
   "answer": 1,
   "explain": "两边除以 −3（负数），不等号反向：x≤−2。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "不等式 x²−4x+3<0 的解集是：",
   "options": [
    "(1,3)",
    "(−∞,1)∪(3,+∞)",
    "[1,3]",
    "(−3,−1)"
   ],
   "answer": 0,
   "explain": "(x−1)(x−3)<0，开口向上，两根之间为负，解集 (1,3)。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "不等式 (x−2)²(x+1)>0 的解集是：",
   "options": [
    "x>−1",
    "x>−1 且 x≠2",
    "x<−1",
    "全体实数"
   ],
   "answer": 1,
   "explain": "x=−1 处穿根、x=2 处偶次不穿；x>−1 且 x≠2 时为正，x=−1 时为零。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "不等式 |x−2|<3 的解集是：",
   "options": [
    "(−1,5)",
    "(−5,−1)",
    "(2,5)",
    "(−∞,5)"
   ],
   "answer": 0,
   "explain": "到 2 的距离小于 3，即 −3<x−2<3，得 −1<x<5。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "解 √(x−1)<2 时，正确的第一步是：",
   "options": [
    "两边平方",
    "移项",
    "确定定义域 x≥1",
    "讨论 x 的正负"
   ],
   "answer": 2,
   "explain": "根号要求被开方数非负，先得 x≥1；再平方得 x−1<4，即 x<5，合起来 1≤x<5。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "用比较法证明 a²+b²≥2ab 时，关键一步是：",
   "options": [
    "移项得 a²+b²−2ab≥0",
    "两边同除 2",
    "取 a=b=1 验证",
    "两边开方"
   ],
   "answer": 0,
   "explain": "作差后配方得 (a−b)²≥0，这是证明的核心；只代特殊值不算证明。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "对正数 a、b，等号成立的条件是：",
   "options": [
    "a=b",
    "a+b=0",
    "ab=1",
    "a=2b"
   ],
   "answer": 0,
   "explain": "(a+b)/2≥√(ab) 的等号当且仅当 a=b 时成立。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q09",
   "chapterId": "__all__",
   "type": "single",
   "question": "不等式 (x−1)(x+2)>0 的解集是：",
   "options": [
    "(−2,1)",
    "(−∞,−2)∪(1,+∞)",
    "[−2,1]",
    "(−∞,1)"
   ],
   "answer": 1,
   "explain": "开口向上，两根 −2、1 之外为正。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q10",
   "chapterId": "__all__",
   "type": "single",
   "question": "若 a>b，则下列一定成立的是：",
   "options": [
    "a²>b²",
    "a−c>b−c",
    "ac>bc",
    "1/a<1/b"
   ],
   "answer": 1,
   "explain": "同减一个数不变号；其余选项在 c 符号不定或 a 为负时不成立。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  }
 ],
 "flashcards": [
  {
   "id": "f01",
   "chapterId": "ch01",
   "front": "「第 1 章：不等式的性质与同解变形」的一句话核心是什么？",
   "back": "不等式只有一条铁律：两边同乘（除）一个负数，不等号方向必须反过来。",
   "tags": [
    "inequalities",
    "核心"
   ]
  },
  {
   "id": "f02",
   "chapterId": "ch02",
   "front": "「第 2 章：二次不等式与高次不等式」的一句话核心是什么？",
   "back": "二次不等式的解集由“开口方向 + 零点位置”决定；高次不等式用数轴上的符号变化判断。",
   "tags": [
    "inequalities",
    "核心"
   ]
  },
  {
   "id": "f03",
   "chapterId": "ch03",
   "front": "「第 3 章：绝对值不等式与无理不等式」的一句话核心是什么？",
   "back": "绝对值是距离，无理不等式要先保证根号有意义，再平方——两步顺序不能颠倒。",
   "tags": [
