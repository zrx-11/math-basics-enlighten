 "glossary": [
  {
   "term": "同解不等式",
   "def": "解集完全相同的不等式。",
   "chapterId": "ch01"
  },
  {
   "term": "可乘性",
   "def": "两边同乘正数不变号、乘负数变号的性质。",
   "chapterId": "ch01"
  },
  {
   "term": "解集",
   "def": "使不等式成立的所有取值组成的集合。",
   "chapterId": "ch01"
  },
  {
   "term": "穿针引线法",
   "def": "按零点次数在数轴上交替取符号解高次不等式的方法。",
   "chapterId": "ch02"
  },
  {
   "term": "重根",
   "def": "方程中重复出现的根，对应因式的幂次大于 1。",
   "chapterId": "ch02"
  },
  {
   "term": "绝对值不等式",
   "def": "含 |x| 或 |ax+b| 的不等式，按距离意义转化。",
   "chapterId": "ch03"
  },
  {
   "term": "无理不等式",
   "def": "根号内含有未知数的不等式。",
   "chapterId": "ch03"
  },
  {
   "term": "比较法",
   "def": "作差或作商判断大小的证明方法。",
   "chapterId": "ch04"
  },
  {
   "term": "分析法",
   "def": "从结论出发寻找充分条件的证明方法。",
   "chapterId": "ch04"
  },
  {
   "term": "基本不等式",
   "def": "a²+b²≥2ab；(a+b)/2≥√(ab)（a,b>0）。",
   "chapterId": "ch04"
  }
 ],
