 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "下列关系中，y 是 x 的函数的是：",
   "options": [
    "x²+y²=1",
    "y²=x",
    "y=2x+1",
    "|y|=x"
   ],
   "answer": 2,
   "explain": "其余三个都出现一个 x 对应两个 y 的情况，不满足唯一性。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "f(x)=x² 在 [−1,2] 上的值域是：",
   "options": [
    "[1,4]",
    "[0,4]",
    "[0,1]",
    "[−1,4]"
   ],
   "answer": 1,
   "explain": "x=0 时取到最小值 0，x=2 时取到最大值 4，故值域 [0,4]。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "一次函数 y=3x−6 的零点是：",
   "options": [
    "x=−2",
    "x=2",
    "x=6",
    "x=3"
   ],
   "answer": 1,
   "explain": "3x−6=0 得 x=2。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "若一次函数 y=kx+b 的图象经过第一、二、四象限，则：",
   "options": [
    "k>0，b>0",
    "k<0，b>0",
    "k<0，b<0",
    "k>0，b<0"
   ],
   "answer": 1,
   "explain": "直线下降说明 k<0；与 y 轴交于正半轴说明 b>0。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "y=x²−6x+5 的顶点坐标是：",
   "options": [
    "(3,−4)",
    "(−3,−4)",
    "(3,4)",
    "(3,−5)"
   ],
   "answer": 0,
   "explain": "配方 y=(x−3)²−4，顶点 (3,−4)。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "y=−x²+2x+3 的最大值是：",
   "options": [
    "3",
    "4",
    "−4",
    "2"
   ],
   "answer": 1,
   "explain": "y=−(x−1)²+4，开口向下，x=1 时取最大值 4。"
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "y=2x²−8x+3 的对称轴是：",
   "options": [
    "x=2",
    "x=−2",
    "x=4",
    "x=1"
   ],
   "answer": 0,
   "explain": "对称轴 x=−b/2a=8/4=2。"
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "一次函数 y=−3x+9 中，y 随 x 增大而：",
   "options": [
    "增大",
    "减小",
    "不变",
    "先增后减"
   ],
   "answer": 1,
   "explain": "k=−3<0，函数单调递减。"
  }
 ],
