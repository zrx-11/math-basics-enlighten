 "glossary": [
  {
   "term": "函数",
   "def": "一个输入对应唯一输出的规则。",
   "chapterId": "ch01"
  },
  {
   "term": "定义域",
   "def": "允许输入的所有取值组成的集合。",
   "chapterId": "ch01"
  },
  {
   "term": "值域",
   "def": "所有实际输出组成的集合。",
   "chapterId": "ch01"
  },
  {
   "term": "增函数",
   "def": "x 增大时 y 也增大的函数。",
   "chapterId": "ch01"
  },
  {
   "term": "斜率",
   "def": "一次函数 y=kx+b 中的 k，反映倾斜与增减。",
   "chapterId": "ch02"
  },
  {
   "term": "截距",
   "def": "图象与 y 轴交点的纵坐标 b。",
   "chapterId": "ch02"
  },
  {
   "term": "顶点式",
   "def": "y=a(x−h)²+k 的形式，直接读出顶点。",
   "chapterId": "ch03"
  },
  {
   "term": "对称轴",
   "def": "抛物线关于它左右对称的竖直线 x=−b/2a。",
   "chapterId": "ch03"
  },
  {
   "term": "平均变化率",
   "def": "区间两端函数值之差与自变量之差的比。",
   "chapterId": "ch03"
  }
 ],
