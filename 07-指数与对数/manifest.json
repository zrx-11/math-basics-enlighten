 "glossary": [
  {
   "term": "指数函数",
   "def": "y=aˣ（a>0，a≠1），值域 (0,+∞)。",
   "chapterId": "ch01"
  },
  {
   "term": "零指数",
   "def": "a⁰=1（a≠0）。",
   "chapterId": "ch01"
  },
  {
   "term": "分数指数",
   "def": "a^(m/n)=ⁿ√(aᵐ)，把根式写成指数。",
   "chapterId": "ch01"
  },
  {
   "term": "对数",
   "def": "log_a N=b 表示 aᵇ=N。",
   "chapterId": "ch02"
  },
  {
   "term": "真数",
   "def": "对数记号中的 N，必须大于 0。",
   "chapterId": "ch02"
  },
  {
   "term": "换底公式",
   "def": "log_a N=log_b N/log_b a。",
   "chapterId": "ch02"
  },
  {
   "term": "对数函数",
   "def": "y=log_a x，与指数函数互为反函数。",
   "chapterId": "ch03"
  },
  {
   "term": "幂函数",
   "def": "y=x^α，底是变量、指数是常数。",
   "chapterId": "ch03"
  },
  {
   "term": "增根",
   "def": "解对数方程时使真数非正的解。",
   "chapterId": "ch03"
  }
 ],
