   "type": "single",
   "question": "计算 27^(2/3) 的值：",
   "options": [
    "9",
    "18",
    "3",
    "6"
   ],
   "answer": 0,
   "explain": "27^(2/3)=(³√27)²=3²=9。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "函数 y=(1/2)ˣ 的单调性是：",
   "options": [
    "在 R 上递增",
    "在 R 上递减",
    "先增后减",
    "不单调"
   ],
   "answer": 1,
   "explain": "底数 0<1/2<1，指数函数单调递减。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "log₄16 的值是：",
   "options": [
    "2",
    "4",
    "8",
    "1/2"
   ],
   "answer": 0,
   "explain": "4²=16，故 log₄16=2。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "化简 log₂6−log₂3：",
   "options": [
    "log₂3",
    "1",
    "2",
    "log₂9"
   ],
   "answer": 1,
   "explain": "log₂6−log₂3=log₂(6/3)=log₂2=1。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "函数 y=log₂x 与 y=2ˣ 的图象关于哪条直线对称：",
   "options": [
    "y 轴",
    "x 轴",
    "y=x",
    "y=−x"
   ],
   "answer": 2,
   "explain": "互为反函数的图象关于直线 y=x 对称。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "方程 log₂(x−3)=2 的解是：",
   "options": [
    "x=7",
    "x=1",
    "x=4",
    "x=5"
   ],
   "answer": 0,
   "explain": "x−3=2²=4，得 x=7；真数 4>0，成立。"
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "计算 lg2+lg5 的值：",
   "options": [
    "1",
    "lg7",
    "10",
    "0"
   ],
   "answer": 0,
   "explain": "lg2+lg5=lg10=1。"
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "若 3ˣ=7，则 x 等于：",
   "options": [
    "log₇3",
    "log₃7",
    "7/3",
    "3/7"
   ],
   "answer": 1,
   "explain": "由定义 3ˣ=7 即 x=log₃7。"
  }
 ],
