  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "数列 a_n=1/n 的极限是：",
   "options": [
    "1",
    "0",
    "不存在",
    "∞"
   ],
   "answer": 1,
   "explain": "n 越大 1/n 越接近 0，可任意小。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "ε-N 定义中，N 的作用是：",
   "options": [
    "表示项数上限",
    "表示从第 N 项以后都满足精度要求",
    "表示误差",
    "表示极限值"
   ],
   "answer": 1,
   "explain": "N 是“从这一项开始，之后所有项都落在 ε 范围内”的分界。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "f(x)=x³ 的导数是：",
   "options": [
    "3x²",
    "x²",
    "3x",
    "x³/4"
   ],
   "answer": 0,
   "explain": "由 (x^n)'=nx^(n−1) 得 3x²。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "y=(2x+1)³ 的导数是：",
   "options": [
    "3(2x+1)²",
    "6(2x+1)²",
    "3(2x+1)³",
    "6(2x+1)³"
   ],
   "answer": 1,
   "explain": "链式法则：3(2x+1)²·2=6(2x+1)²。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "∫_0^2 x dx 的值是：",
   "options": [
    "2",
    "4",
    "1",
    "0"
   ],
   "answer": 0,
   "explain": "原函数 x²/2，代入得 4/2−0=2。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "微积分基本定理的作用是：",
   "options": [
    "定义极限",
    "把定积分化为原函数在端点的差",
    "求导数",
    "判断连续"
   ],
   "answer": 1,
   "explain": "∫_a^b f=F(b)−F(a)，把求和变成代端点。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "f(x)=x²−2x 的极小值点是：",
   "options": [
    "x=1",
    "x=0",
    "x=2",
    "x=−1"
   ],
   "answer": 0,
   "explain": "f'(x)=2x−2，零点 x=1，且为极小值点。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "y=x 与 y=x² 在 [0,1] 围成的面积是：",
