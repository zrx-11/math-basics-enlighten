    "1/6",
    "1/3",
    "1/2",
    "1"
   ],
   "answer": 0,
   "explain": "∫_0^1(x−x²)dx=1/2−1/3=1/6。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch04"
   ]
  },
