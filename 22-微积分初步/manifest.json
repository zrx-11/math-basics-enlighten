 "glossary": [
  {
   "term": "极限",
   "def": "变量无限接近某个值的趋势的严格描述。",
   "chapterId": "ch01"
  },
  {
   "term": "ε-N 语言",
   "def": "用任意小的 ε 与分界 N 表述数列极限。",
   "chapterId": "ch01"
  },
  {
   "term": "连续",
   "def": "函数在某点的极限等于函数值。",
   "chapterId": "ch02"
  },
  {
   "term": "导数",
   "def": "差商当 h→0 时的极限，表示瞬时变化率。",
   "chapterId": "ch02"
  },
  {
   "term": "链式法则",
   "def": "复合函数求导：外层导数乘内层导数。",
   "chapterId": "ch02"
  },
  {
   "term": "微分",
   "def": "增量的线性主部 dy=f'(x)dx。",
   "chapterId": "ch03"
  },
  {
   "term": "定积分",
   "def": "分割求和的极限，表示累积量。",
   "chapterId": "ch03"
  },
  {
   "term": "原函数",
   "def": "导数等于被积函数的函数。",
   "chapterId": "ch03"
  },
  {
   "term": "极值",
   "def": "局部最大或最小值。",
   "chapterId": "ch04"
  }
 ],
