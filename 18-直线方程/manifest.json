 "glossary": [
  {
   "term": "倾斜角",
   "def": "直线向上方向与 x 轴正方向的夹角。",
   "chapterId": "ch01"
  },
  {
   "term": "斜率",
   "def": "倾斜角的正切，反映直线的倾斜程度。",
   "chapterId": "ch01"
  },
  {
   "term": "点斜式",
   "def": "y−y₀=k(x−x₀)。",
   "chapterId": "ch02"
  },
  {
   "term": "斜截式",
   "def": "y=kx+b。",
   "chapterId": "ch02"
  },
  {
   "term": "截距式",
   "def": "x/a+y/b=1。",
   "chapterId": "ch02"
  },
  {
   "term": "一般式",
   "def": "Ax+By+C=0（A、B 不全为零）。",
   "chapterId": "ch02"
  },
  {
   "term": "点到直线距离",
   "def": "点与直线上最近点的距离。",
   "chapterId": "ch03"
  },
  {
   "term": "夹角",
   "def": "两直线所成的锐角或直角。",
   "chapterId": "ch03"
  }
 ],
