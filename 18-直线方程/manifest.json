   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "过点 (1,1) 与 (3,5) 的直线斜率是：",
   "options": [
    "1",
    "2",
    "4",
    "1/2"
   ],
   "answer": 1,
   "explain": "k=(5−1)/(3−1)=2。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
