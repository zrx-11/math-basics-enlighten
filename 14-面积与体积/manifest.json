 "glossary": [
  {
   "term": "面积",
   "def": "图形包含的单位正方形个数。",
   "chapterId": "ch01"
  },
  {
   "term": "割补法",
   "def": "剪切重拼求面积的方法。",
   "chapterId": "ch01"
  },
  {
   "term": "等积变形",
   "def": "形状改变而面积不变的变形。",
   "chapterId": "ch01"
  },
  {
   "term": "圆周率",
   "def": "圆周长与直径之比 π。",
   "chapterId": "ch02"
  },
  {
   "term": "扇形",
   "def": "两条半径与一段弧围成的图形。",
   "chapterId": "ch02"
  },
  {
   "term": "弓形",
   "def": "弦与弧围成的图形。",
   "chapterId": "ch02"
  },
  {
   "term": "祖暅原理",
   "def": "等高处截面积相等的两个立体体积相等。",
   "chapterId": "ch03"
  },
  {
   "term": "辛普森公式",
   "def": "V=(h/6)(S顶+4S中+S底)。",
   "chapterId": "ch03"
  },
  {
   "term": "台体",
   "def": "锥体被平行于底面的平面截去上部后的部分。",
   "chapterId": "ch03"
  }
 ],
