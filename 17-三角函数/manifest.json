 "glossary": [
  {
   "term": "弧度",
   "def": "弧长与半径之比定义的角的度量。",
   "chapterId": "ch01"
  },
  {
   "term": "终边相同的角",
   "def": "相差 360° 整数倍的角。",
   "chapterId": "ch01"
  },
  {
   "term": "正弦",
   "def": "单位圆上角的终边交点的纵坐标。",
   "chapterId": "ch01"
  },
  {
   "term": "余弦",
   "def": "单位圆上角的终边交点的横坐标。",
   "chapterId": "ch01"
  },
  {
   "term": "诱导公式",
   "def": "把任意角三角比化为锐角三角比的公式。",
   "chapterId": "ch02"
  },
  {
   "term": "加法定理",
   "def": "展开 α±β 三角比的公式。",
   "chapterId": "ch03"
  },
  {
   "term": "二倍角公式",
   "def": "sin2α、cos2α、tan2α 的公式。",
   "chapterId": "ch03"
  },
  {
   "term": "周期",
   "def": "函数值重复出现的最小正间隔。",
   "chapterId": "ch04"
  },
  {
   "term": "振幅",
   "def": "y=A sin(ωx+φ) 中的 |A|。",
   "chapterId": "ch04"
  },
  {
   "term": "通解",
   "def": "含整数 k、表示全部解的表达式。",
   "chapterId": "ch04"
  }
 ],
