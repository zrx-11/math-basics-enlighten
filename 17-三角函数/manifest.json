 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "与 −30° 终边相同的角是：",
   "options": [
    "30°",
    "330°",
    "300°",
    "150°"
   ],
   "answer": 1,
   "explain": "−30°+360°=330°。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "150° 化为弧度是：",
   "options": [
    "5π/6",
    "2π/3",
    "3π/4",
    "7π/6"
   ],
   "answer": 0,
   "explain": "150°=150×π/180=5π/6。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "sin210° 的值是：",
   "options": [
    "1/2",
    "−1/2",
    "√3/2",
    "−√3/2"
   ],
   "answer": 1,
   "explain": "sin210°=sin(180°+30°)=−sin30°=−1/2。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "已知 cosθ=−3/5 且 θ 在第三象限，则 sinθ 为：",
   "options": [
    "4/5",
    "−4/5",
    "3/5",
    "−3/5"
   ],
   "answer": 1,
   "explain": "第三象限正弦为负，sinθ=−√(1−9/25)=−4/5。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "cos(α+β) 展开为：",
   "options": [
    "cosαcosβ+sinαsinβ",
    "cosαcosβ−sinαsinβ",
    "sinαcosβ+cosαsinβ",
    "sinαcosβ−cosαsinβ"
   ],
   "answer": 1,
   "explain": "余弦和角公式为 cosαcosβ−sinαsinβ。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "sin2α 等于：",
   "options": [
    "2sinα",
    "2sinαcosα",
    "sin²α−cos²α",
    "1−2sin²α"
   ],
   "answer": 1,
   "explain": "二倍角正弦公式为 2sinαcosα。"
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "y=2sin(3x) 的周期是：",
   "options": [
    "2π",
    "2π/3",
    "3π",
    "π/3"
   ],
   "answer": 1,
   "explain": "T=2π/|ω|=2π/3。"
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "方程 cosx=0 的通解是：",
   "options": [
    "x=kπ",
    "x=π/2+kπ",
    "x=2kπ",
    "x=π/4+kπ"
   ],
   "answer": 1,
   "explain": "余弦为零的角是 π/2 的奇数倍，即 x=π/2+kπ。"
  },
  {
   "id": "q09",
   "chapterId": "__all__",
   "type": "single",
   "question": "sin(π/6) 的值是：",
   "options": [
    "1/2",
    "√3/2",
    "√2/2",
    "1"
   ],
   "answer": 0,
   "explain": "π/6=30°，sin30°=1/2。"
  },
  {
   "id": "q10",
   "chapterId": "__all__",
   "type": "single",
   "question": "y=sin(2x−π/3) 的周期是：",
   "options": [
    "π",
    "2π",
    "π/2",
    "4π"
   ],
   "answer": 0,
   "explain": "T=2π/2=π。"
  }
 ],
