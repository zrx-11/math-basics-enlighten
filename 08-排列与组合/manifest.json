 "glossary": [
  {
   "term": "加法原理",
   "def": "分类计数，各类互斥则相加。",
   "chapterId": "ch01"
  },
  {
   "term": "乘法原理",
   "def": "分步计数，各步相依则相乘。",
   "chapterId": "ch01"
  },
  {
   "term": "排列",
   "def": "取出的元素要计顺序的排法。",
   "chapterId": "ch01"
  },
  {
   "term": "全排列",
   "def": "n 个元素全部参与排列，共 n! 种。",
   "chapterId": "ch01"
  },
  {
   "term": "组合",
   "def": "只计取出哪些元素、不计顺序。",
   "chapterId": "ch02"
  },
  {
   "term": "组合数",
   "def": "C(n,m)=n!/[m!(n−m)!]。",
   "chapterId": "ch02"
  },
  {
   "term": "可重复排列",
   "def": "元素可重复取用，数目为 nᵐ。",
   "chapterId": "ch03"
  },
  {
   "term": "均匀分组",
   "def": "各组元素个数相同，需除以组数阶乘。",
   "chapterId": "ch03"
  },
  {
   "term": "分配",
   "def": "把分好的组派到有标号的位置。",
   "chapterId": "ch03"
  }
 ],
