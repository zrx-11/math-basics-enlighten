 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "从 5 人中选 3 人排成一排，共有多少种排法：",
   "options": [
    "10",
    "60",
    "125",
    "15"
   ],
   "answer": 1,
   "explain": "A(5,3)=5×4×3=60。"
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "从甲地到乙地有 3 条路，从乙地到丙地有 4 条路，从甲到丙必须经乙，共有多少种走法：",
   "options": [
    "7",
    "12",
    "34",
    "4"
   ],
   "answer": 1,
   "explain": "分两步，用乘法原理：3×4=12。"
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "从 6 名同学中选 2 名当代表，共有多少种选法：",
   "options": [
    "30",
    "15",
    "12",
    "36"
   ],
   "answer": 1,
   "explain": "不分顺序，C(6,2)=15。"
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "C(10,3) 的值是：",
   "options": [
    "120",
    "720",
    "240",
    "90"
   ],
   "answer": 0,
   "explain": "C(10,3)=10×9×8/6=120。"
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "用 1、2、3 组成允许重复的三位数，共有多少个：",
   "options": [
    "6",
    "9",
    "27",
    "81"
   ],
   "answer": 2,
   "explain": "每一位都有 3 种选择：3³=27。"
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "6 人平均分成 3 组，每组 2 人，共有多少种分法：",
   "options": [
    "90",
    "15",
    "60",
    "20"
   ],
   "answer": 1,
   "explain": "C(6,2)C(4,2)C(2,2)/3!=15×6×1/6=15。"
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "从 7 人中选 3 人排成一排照相，共有多少种排法：",
   "options": [
    "35",
    "210",
    "343",
    "21"
   ],
   "answer": 1,
   "explain": "有序，A(7,3)=7×6×5=210。"
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "把 4 本不同的书平均分成两堆，每堆 2 本，共有多少种分法：",
   "options": [
    "6",
    "3",
    "12",
    "4"
   ],
   "answer": 1,
   "explain": "C(4,2)C(2,2)/2!=3，两堆无标号要除以 2!。"
  }
 ],
