   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "复数 z=2−3i 的实部与虚部分别是：",
   "options": [
    "2 和 3",
    "2 和 −3",
    "−3 和 2",
    "3 和 2"
   ],
   "answer": 1,
   "explain": "z=a+bi 中 a=2，b=−3（虚部是 b 本身，含符号）。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "i³ 的值是：",
   "options": [
    "i",
    "−i",
    "1",
    "−1"
   ],
   "answer": 1,
   "explain": "i³=i²·i=−1·i=−i。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "(2+i)(1−i) 的结果是：",
   "options": [
    "3−i",
    "3+i",
    "1−i",
    "1+i"
   ],
   "answer": 0,
   "explain": "2−2i+i−i²=2−i+1=3−i。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "复数 z=3+4i 的模是：",
   "options": [
    "7",
    "5",
    "25",
    "1"
   ],
   "answer": 1,
   "explain": "|z|=√(9+16)=5。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "复数 z=1+i 的模与辐角（主值）分别是：",
   "options": [
    "√2 和 45°",
    "2 和 45°",
    "√2 和 135°",
    "1 和 90°"
   ],
   "answer": 0,
   "explain": "r=√(1+1)=√2，cosθ=1/√2，故 θ=45°。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "用棣莫弗定理计算 (1+i)⁴，结果是：",
   "options": [
    "4",
    "−4",
    "4i",
    "−4i"
   ],
   "answer": 1,
   "explain": "模 √2 的四次方为 4，角 45°×4=180°，故结果为 4(cos180°+i sin180°)=−4。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "type": "single",
   "question": "复数 (1+i)/(1−i) 的值是：",
   "options": [
    "i",
    "−i",
    "1",
    "−1"
   ],
   "answer": 0,
   "explain": "分子分母同乘 (1+i)：(1+i)²/(1+1)=(2i)/2=i。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "type": "single",
   "question": "方程 x²+4=0 在复数范围内的解是：",
   "options": [
    "x=2",
    "x=±2i",
    "x=±2",
    "无解"
   ],
   "answer": 1,
   "explain": "x²=−4，故 x=±2i。",
