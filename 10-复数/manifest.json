 "glossary": [
  {
   "term": "虚数单位",
   "def": "满足 i²=−1 的数 i。",
   "chapterId": "ch01"
  },
  {
   "term": "复数",
   "def": "形如 a+bi 的数，a、b 为实数。",
   "chapterId": "ch01"
  },
  {
   "term": "实部与虚部",
   "def": "复数 a+bi 中的 a 与 b。",
   "chapterId": "ch01"
  },
  {
   "term": "共轭复数",
   "def": "实部相同、虚部相反的复数。",
   "chapterId": "ch02"
  },
  {
   "term": "模",
   "def": "复数到原点的距离 √(a²+b²)。",
   "chapterId": "ch02"
  },
  {
   "term": "复平面",
   "def": "横轴实轴、纵轴虚轴的坐标平面。",
   "chapterId": "ch02"
  },
  {
   "term": "辐角",
   "def": "复数向量与实轴正方向的夹角。",
   "chapterId": "ch03"
  },
  {
   "term": "三角形式",
   "def": "z=r(cosθ+i sinθ)。",
   "chapterId": "ch03"
  },
  {
   "term": "棣莫弗定理",
   "def": "乘方公式 [r(cosθ+i sinθ)]ⁿ=rⁿ(cos nθ+i sin nθ)。",
   "chapterId": "ch03"
  }
 ],
