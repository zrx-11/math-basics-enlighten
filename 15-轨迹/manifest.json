  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "若 A⊆B，则 A 是 B 的：",
   "options": [
    "充分条件",
    "必要条件",
    "充要条件",
    "无关条件"
   ],
   "answer": 0,
   "explain": "A 中每个元素都在 B 中，故 A 成立可推出 B 成立，A 是 B 的充分条件。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "求轨迹时“检验”这一步主要检查：",
   "options": [
