 "glossary": [
  {
   "term": "单项式",
   "def": "数与字母的乘积，单独一个数或字母也算。",
   "chapterId": "ch01"
  },
  {
   "term": "系数",
   "def": "单项式中的数字因数。",
   "chapterId": "ch01"
  },
  {
   "term": "次数",
   "def": "单项式各字母指数之和；多项式取最高次项的次数。",
   "chapterId": "ch01"
  },
  {
   "term": "同类项",
   "def": "字母相同且相同字母指数也相同的项。",
   "chapterId": "ch01"
  },
  {
   "term": "分配律",
   "def": "a(b+c)=ab+ac，整式变形的基本依据。",
   "chapterId": "ch01"
  },
  {
   "term": "乘法公式",
   "def": "平方差、完全平方、立方和差三组展开结果。",
   "chapterId": "ch02"
  },
  {
   "term": "长除法",
   "def": "逐次消去最高次项的多项式除法。",
   "chapterId": "ch03"
  },
  {
   "term": "带余除式",
   "def": "A=BQ+R，余式次数低于除式。",
   "chapterId": "ch03"
  },
  {
   "term": "恒等",
   "def": "对字母的一切取值两边都相等。",
   "chapterId": "ch04"
  },
  {
   "term": "待定系数法",
   "def": "设出含未知系数的形式，再比较系数求解。",
   "chapterId": "ch04"
  }
 ],
