 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "type": "single",
   "question": "−3x²y 的系数与次数分别是：",
   "options": [
    "−3，2",
    "−3，3",
    "3，3",
    "3，2"
   ],
   "answer": 1,
   "explain": "系数是数字因数 −3；次数是各字母指数之和 2+1=3。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "type": "single",
   "question": "化简 a−(2a−b)+b 的结果是：",
   "options": [
    "−a+2b",
    "−a",
    "3a",
    "−a−2b"
   ],
   "answer": 0,
   "explain": "去括号：a−2a+b+b = −a+2b。括号前是负号，−b 变 +b。",
   "relatedConceptId": "c01",
   "prerequisites": [
    "ch01"
   ]
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "type": "single",
   "question": "展开 (2x−3)(2x+3) 的结果是：",
   "options": [
    "4x²−9",
    "4x²+9",
    "4x²−12x+9",
    "4x²−6x−9"
   ],
   "answer": 0,
   "explain": "平方差公式：(2x)²−3²=4x²−9。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "type": "single",
   "question": "计算 102×98 最简便的算法是：",
   "options": [
    "102×100−102×2",
    "(100+2)(100−2)=100²−4",
    "100×98+2×98",
    "直接竖式相乘"
   ],
   "answer": 1,
   "explain": "102×98=(100+2)(100−2)=100²−2²=9996，用平方差一步到位。",
   "relatedConceptId": "",
   "prerequisites": [
    "ch02"
   ]
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "type": "single",
   "question": "12x⁴y²÷3x²y 的结果是：",
   "options": [
    "4x²y",
    "4x⁶y³",
    "4x²y²",
    "4x²"
   ],
   "answer": 0,
   "explain": "系数 12÷3=4；x 的指数 4−2=2；y 的指数 2−1=1，得 4x²y。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "type": "single",
   "question": "(x²−1)÷(x−1) 的商与余式分别是：",
   "options": [
    "x+1，0",
    "x−1，0",
    "x+1，2",
    "x，1"
   ],
   "answer": 0,
   "explain": "x²−1=(x−1)(x+1)，整除，商 x+1，余式 0。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch03"
   ]
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "type": "single",
   "question": "若 x²+ax+b≡(x−1)(x+4)，则 a、b 为：",
   "options": [
    "a=3，b=−4",
    "a=5，b=4",
    "a=−3，b=−4",
    "a=3，b=4"
   ],
   "answer": 0,
   "explain": "右边展开 x²+3x−4，比较系数得 a=3，b=−4。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "type": "single",
   "question": "两个三次多项式在几个不同点上取值相同，就一定能判定它们恒等？",
   "options": [
    "2 个",
    "3 个",
    "4 个",
    "1 个"
   ],
   "answer": 2,
   "explain": "次数为 3，需要 n+1=4 个不同的点；少于 4 个不足以排除差多项式有根的情况。",
   "relatedConceptId": "c02",
   "prerequisites": [
    "ch04"
   ]
  },
  {
   "id": "q09",
   "chapterId": "__all__",
   "type": "single",
   "question": "下列各组中，是同类项的是：",
   "options": [
    "3x²y 与 3xy²",
    "−2ab 与 5ba",
    "x² 与 x³",
    "2a 与 2b"
   ],
   "answer": 1,
   "explain": "−2ab 与 5ba 字母相同、指数都是 1，是同类项；其余三组字母或指数不同。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q10",
   "chapterId": "__all__",
   "type": "single",
   "question": "(x³+1)÷(x+1) 的商是：",
   "options": [
    "x²−x+1",
    "x²+x+1",
    "x²−1",
    "x²+1"
   ],
   "answer": 0,
   "explain": "x³+1=(x+1)(x²−x+1)，故商为 x²−x+1，余式 0。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  },
  {
   "id": "q11",
   "chapterId": "__all__",
   "type": "single",
   "question": "若 2x²+ax−3≡2(x−1)(x+2)+b，则 a、b 为：",
   "options": [
    "a=2，b=1",
    "a=2，b=−3",
    "a=−2，b=1",
    "a=1，b=1"
   ],
   "answer": 0,
   "explain": "右边展开得 2x²+2x−4+b。比较 x 项系数得 a=2；比较常数项 −3=−4+b 得 b=1。",
   "relatedConceptId": "",
   "prerequisites": [
    "__all__"
   ]
  }
 ],
 "flashcards": [
  {
   "id": "f01",
   "chapterId": "ch01",
   "front": "「第 1 章：整式的概念与加减法」的一句话核心是什么？",
   "back": "整式的加减只做一件事：把字母部分完全相同的项并起来，系数相加。",
   "tags": [
    "zhengshi",
    "核心"
   ]
  },
  {
   "id": "f02",
   "chapterId": "ch02",
   "front": "「第 2 章：整式的乘法与乘法公式」的一句话核心是什么？",
   "back": "乘法就是反复用分配律展开；指数法则负责字母部分，乘法公式是展开结果的压缩记忆。",
   "tags": [
    "zhengshi",
    "核心"
   ]
  },
  {
   "id": "f03",
   "chapterId": "ch03",
   "front": "「第 3 章：整式的除法」的一句话核心是什么？",
   "back": "除法是指数法则的逆用；除不尽时写成 A=BQ+R，余式的次数必须低于除式。",
   "tags": [
    "zhengshi",
    "核心"
   ]
  },
  {
   "id": "f04",
   "chapterId": "ch04",
   "front": "「第 4 章：多项式恒等定理与待定系数法」的一句话核心是什么？",
   "back": "两个次数不超过 n 的多项式，只要在 n+1 个不同点取值相同，就恒等；于是可以设出系数再解方程。",
